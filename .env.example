# Discord Bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Anthropic (Claude API)
ANTHROPIC_API_KEY=

# Google OAuth (Calendar / Gmail)
# scripts/google-auth-setup.ts で取得したclient情報とrefresh tokenを設定
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:53682/oauth2callback
GOOGLE_REFRESH_TOKEN=

# SQLite DB file path
DB_PATH=./data.sqlite

# 毎日の自動リマインド（任意。REMINDER_USER_IDを設定すると有効になる）
# Discordの自分のユーザーIDを入れる（取得方法はREADME参照）
REMINDER_USER_ID=
# 毎日リマインドを送る時刻（0-23の24時間表記、ロボットを動かしているパソコンの時刻基準）
REMINDER_HOUR=8
